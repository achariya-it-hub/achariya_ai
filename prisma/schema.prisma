generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("member")
  avatar    String?
  department String
  title    String
  phone    String
  joinDate String
  status   String   @default("active")
  attendanceEnabled Boolean @default(true)
  createdAt DateTime @default(now())

  ownedProjects   Project[]   @relation("ProjectOwner")
  assignedProjects ProjectMember[]
  assignedTasks   Task[]      @relation("TaskAssignee")
  hostedMeetings  Meeting[]   @relation("MeetingHost")
  meetingAttendees MeetingAttendee[]
  activities       Activity[]
  attendance       Attendance[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String
  business    String?
  status      String   @default("active")
  priority    String   @default("medium")
  startDate   String
  endDate     String
  progress    Int      @default(0)
  color       String   @default("#6366f1")
  ownerId     String
  createdAt   DateTime @default(now())

  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  dueDate     String
  status      String   @default("upcoming")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id                String   @id @default(cuid())
  projectId         String
  milestoneId       String?
  title             String
  description       String
  status            String   @default("todo")
  workflowState     String?
  isPaused          Boolean  @default(false)
  priority          String   @default("medium")
  assigneeId        String?
  assignedByName    String?
  dueDate           String?
  dueTime           String?
  completedAt       String?
  order             Int      @default(0)
  payout            Float    @default(0)
  payoutStatus      String?
  reviewFeedback    String?
  submissionRemarks String?
  proofNote         String?
  marketingType     String?
  creativeType      String?
  platform          String?
  sbu               String?
  assetCode         String?
  taskCode          String?
  workloadPercent   Float?
  isManualWorkload  Boolean  @default(false)
  estimatedHours    Float?
  actualHours       Float?
  assignedAt        String?
  officialDeadline  String?
  warningDeadline   String?
  criticalDeadline  String?
  referenceLink     String?
  driveLink         String?
  finalOutputLink   String?
  remarks           String?
  commentsJson      String?
  activityJson      String?
  createdAt         DateTime @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  proofs    TaskProof[]
}

model TaskProof {
  id        String   @id @default(cuid())
  taskId    String
  name      String?
  url       String
  type      String   @default("link")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  roomName    String   @unique
  hostId      String
  status      String   @default("scheduled")

  host       User              @relation("MeetingHost", fields: [hostId], references: [id])
  attendees  MeetingAttendee[]
}

model MeetingAttendee {
  id        String @id @default(cuid())
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String
  targetId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WhatsappConfig {
  id               String   @id @default("default")
  phoneNumberId    String?
  groupId          String?  @default("group-crm-main")
  webhookToken     String?  @default("wh_token_achariya_crm")
  defaultProjectId String?
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt @default(now())
}

model WhatsappMessageLog {
  id           String   @id @default(cuid())
  senderPhone  String
  senderName   String?
  groupId      String?
  rawMessage   String
  parsedAction String?
  status       String   @default("PROCESSED")
  taskId       String?
  userId       String?
  createdAt    DateTime @default(now())
}

model SocialPost {
  id               String    @id @default(cuid())
  title            String
  description      String?
  company          String?   @default("Digiventures")
  platform         String
  status           String    @default("idea")
  scheduledAt      DateTime?
  publishedAt      DateTime?
  postUrl          String?
  createdById      String?
  assigneeId       String?
  content          String?
  mediaUrl         String?
  hashtags         String?
  isProcessed      Boolean   @default(false)
  reminderInterval Int       @default(30)
  lastRemindedAt   DateTime?
  snoozedUntil     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt @default(now())
}

model CalendarEvent {
  id               String    @id @default(cuid())
  title            String
  description      String?
  company          String?   @default("Digiventures")
  type             String    @default("event")
  category         String    @default("General")
  priority         String    @default("medium")
  status           String    @default("pending")
  isProcessed      Boolean   @default(false)
  processedAt      DateTime?
  processedBy      String?
  start            DateTime
  end              DateTime?
  allDay           Boolean   @default(false)
  location         String?
  clientName       String?
  clientPhone      String?
  clientEmail      String?
  reminderInterval Int       @default(15)
  reminderUnit     String    @default("minutes")
  lastRemindedAt   DateTime?
  snoozedUntil     DateTime?
  reminderCount    Int       @default(0)
  assigneeId       String?
  projectId        String?
  color            String?
  source           String    @default("manual")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt @default(now())
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  status     String   @default("sent")
  fileUrl    String?
  fileName   String?
  createdAt  DateTime @default(now())
}

